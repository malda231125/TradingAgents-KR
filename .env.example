# TradingAgents Korea environment example
#
# Copy this file to `.env` and fill in your own credentials.
# Never commit `.env`.

# -----------------------------------------------------------------------------
# LLM runtime
# -----------------------------------------------------------------------------
# Auto-detect (recommended): leave the provider/model lines below commented out,
# and the runtime picks an installed CLI automatically — codex preferred, then
# claude — with matching default models. `cp .env.example .env` then "just works"
# whether you have Codex CLI or Claude Code installed.
#
# To pin a choice instead, uncomment exactly ONE block:
#
# Codex CLI:
#   TRADINGAGENTS_LLM_PROVIDER=codex-cli
#   TRADINGAGENTS_QUICK_MODEL=gpt-5.5
#   TRADINGAGENTS_DEEP_MODEL=gpt-5.5
#
# Claude Code CLI:
#   TRADINGAGENTS_LLM_PROVIDER=claude-cli
#   TRADINGAGENTS_QUICK_MODEL=sonnet
#   TRADINGAGENTS_DEEP_MODEL=opus
#   TRADINGAGENTS_CLI_EFFORT=max   # claude-cli only
TRADINGAGENTS_CLI_TIMEOUT=1800

# Max retries for a failing CLI call before giving up (default 2).
#TRADINGAGENTS_CLI_MAX_RETRIES=2

# Reasoning effort — claude-cli only (ignored by codex-cli): low|medium|high|xhigh|max
# Leave unset for Claude's default effort; set max for the highest reasoning level.
#TRADINGAGENTS_CLI_EFFORT=max

# Output language for agents and the final report.
# ko (default) | en | ja | zh — unknown codes fall back to en.
TRADINGAGENTS_REPORT_LANGUAGE=ko

# Optional runtime timing logs for debugging bottlenecks.
#TRADINGAGENTS_TIMING_LOGS=1

# Optional output location.
TRADINGAGENTS_RESULTS_DIR=./results

# -----------------------------------------------------------------------------
# KIS — structured Korean stock data
# -----------------------------------------------------------------------------
# Used for price, OHLCV, technical indicators, fundamentals and market data.
# Issue keys from: https://apiportal.koreainvestment.com/
KIS_APP_KEY=
KIS_APP_SECRET=

# Optional: custom token cache path.
#KIS_TOKEN_CACHE_PATH=./data_cache/kis-token.json

# -----------------------------------------------------------------------------
# Naver News API — domestic Korean news
# -----------------------------------------------------------------------------
# Register an app from: https://developers.naver.com/apps/#/register
# Search API docs: https://developers.naver.com/docs/serviceapi/search/news/news.md
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# DART — disclosures and event-style signals
# -----------------------------------------------------------------------------
# OpenDART: https://opendart.fss.or.kr/
DART_API_KEY=

# -----------------------------------------------------------------------------
# ECOS — Korea macro context
# -----------------------------------------------------------------------------
# Bank of Korea ECOS Open API: https://ecos.bok.or.kr/api/
ECOS_API_KEY=

# -----------------------------------------------------------------------------
# Optional global context
# -----------------------------------------------------------------------------
# FRED API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SEC EDGAR does not use an API key, but automated requests need an identifying User-Agent.
# Guidance: https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="TradingAgentsKorea/0.1 contact@example.com"

# -----------------------------------------------------------------------------
# Notion export helper — optional
# -----------------------------------------------------------------------------
# Notion internal integration guide:
# https://developers.notion.com/guides/get-started/internal-connections
NOTION_API_TOKEN=
TRADINGAGENTS_NOTION_PAGE_ID=

# -----------------------------------------------------------------------------
# Telegram bot — optional
# -----------------------------------------------------------------------------
# Create a bot with BotFather: https://t.me/BotFather
# Bot API docs: https://core.telegram.org/bots/api
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
